{
  "compilerOptions": {
    "strict": true,
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    // Os testes rodam no runner nativo do Node, que exige a extensão .ts
    // explícita no import.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  }
}
