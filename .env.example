# ── Database ──────────────────────────────────────────────────────────────────
# Coolify: use the internal Postgres URL from the database service
DATABASE_URL=postgresql://vapt:vapt@localhost:5432/vapt

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# ── API service ───────────────────────────────────────────────────────────────
# Port the NestJS API listens on (default 3333)
PORT=3333
NODE_ENV=production

# ── Web service ───────────────────────────────────────────────────────────────
# Internal URL (server-side fetch) — use private network name in Coolify
API_URL=http://api:3333

# Public URL (browser fetch) — must be the public-facing API domain
NEXT_PUBLIC_API_URL=https://api.vapt.com.br

# ── Payments — Asaas ──────────────────────────────────────────────────────────
# Chave da API. Sandbox começa com $aact_hmlg_, produção com $aact_prod_.
#
# A chave começa com "$". O dotenv lê o valor literal (não expandimos
# variáveis), mas o "$" ainda é interpretado se a chave passar por um shell
# (`export VAR=$aact_...` vira string vazia) ou pela interpolação do
# docker-compose. As aspas simples abaixo são a proteção barata contra isso.
#
# O Asaas autentica pelo header `access_token`, não por `Authorization: Bearer`,
# e a chave precisa ser do mesmo ambiente da URL abaixo.
ASAAS_API_KEY='$aact_hmlg_cole-a-chave-aqui'

# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token definido por você no painel do Asaas ao cadastrar o webhook; chega em
# cada requisição para provarmos que o evento veio mesmo do Asaas.
# Gere com: openssl rand -base64 32
ASAAS_WEBHOOK_SECRET=change-me
